# Backend env premenné. Skopíruj do .env (gitignored) a doplň hodnoty.

# V produkcii presne APP_ENV=production: s ostrým kľúčom Stripe a inou hodnotou
# denná kontrola nezapisuje do Stripe (opakovanie udalostí, počty technikov)
# a Kontrola fakturácie to hlási ako chybu.
APP_ENV=local
APP_DEBUG=true

# Lokálny Docker MariaDB (z docker-compose.yml).
DB_HOST=db
DB_PORT=3306
DB_NAME=firol
DB_USER=firol
DB_PASS=firol

# Produkcia: nastav podľa konfigurácie tvojho production servera.
# DB_HOST=<prod-db-host>
# DB_PORT=3306
# DB_NAME=<prod-db-name>
# DB_USER=<prod-db-user>
# DB_PASS=<prod-db-pass>

# Stripe — všetkých 5 hodnôt z dashboard.stripe.com (test mode pre dev, live pre prod).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Produkt (prod_…), pod ktorým vzniká položka extra technika v predplatnom aj v
# Checkoute. Založ ho v Stripe raz (napr. „POapp — extra technik", bez ceny —
# cenu dáva aplikácia) v test aj live režime. Musí to byť samostatný produkt,
# nie produkt základného predplatného. Bez neho sa extra technik nedá pridať do
# existujúceho predplatného (Checkout použije náhradný produkt) a Administrácia
# → Kontrola fakturácie hlási chybu.
STRIPE_PRODUCT_EXTRA_TECHNICIAN=prod_...
# BILLING_RECONCILE=on|off (nenastavené = on). `off` — počet extra technikov sa
# do Stripe neposiela: webhooky len zapisujú stav, bin/billing-daily.php len
# hlási rozdiely a „Ďalšia fakturácia" ukazuje počet zo Stripe. Na prvé
# nasadenie (najprv výpis bin/billing-seat-report.php, potom rozhodnutie
# vlastníka, potom zapnúť — README). Iná hodnota než on/off sa berie ako `off`
# a Kontrola fakturácie ju hlási ako chybu; `off` dlhšie ako 3 dni tiež.
# BILLING_RECONCILE=off

# DPH (rozhodnutie vlastníka z 18. 11. 2026): ceny v cenníku sú bez DPH, zákazník
# platí cenu + DPH. VAT_RATE_PERCENT je jediné nastavenie sadzby (obrazovky,
# e-maily, faktúra v iDoklade, kontrola sadzby v Stripe); nenastavené = 23.
# STRIPE_TAX_RATE_ID — daňová sadzba v Stripe (Products → Tax rates): DPH
# s rovnakým percentom, „exclusive" (pripočítava sa k cene), krajina SK. Založ ju
# raz v test aj live režime (txr_…). Checkout ju dá predplatnému ako predvolenú,
# denná kontrola ju doplní každému živému predplatnému, ktoré ju nemá (pri
# BILLING_RECONCILE=on). Bez nej je Checkout zablokovaný a Kontrola fakturácie
# hlási chybu.
VAT_RATE_PERCENT=23
STRIPE_TAX_RATE_ID=txr_...

# Neuhradená obnova predplatného: koľko dní je účet ešte plne použiteľný (od
# neúspešnej platby), potom len na čítanie až do zaplatenia. Nenastavené = 14.
# PAYMENT_GRACE_DAYS=14

# iDoklad — z app.idoklad.cz/Account/Authorization (OAuth2 client_credentials).
# Žiadny sandbox neexistuje a iDoklad nemá koncepty: každá odoslaná faktúra je
# ostrá a očíslovaná. Preto:
#   IDOKLAD_ISSUE_MODE=send|prepare — predvolene `send` len pri APP_ENV=production,
#     inde `prepare`: payload faktúry sa zostaví a uloží k riadku v `invoices`,
#     ale do iDokladu sa nič nepošle. V PRODUKCII NASTAV IDOKLAD_ISSUE_MODE=send
#     výslovne (nespoliehaj sa na APP_ENV). Ostrý kľúč Stripe bez `send` hlási
#     Kontrola fakturácie ako chybu; samotný ostrý kľúč `send` nezapína.
#   IDOKLAD_ALLOW_TEST_EVENTS=true — iba ak má ísť do iDokladu aj platba
#     z testovacieho režimu Stripe (livemode=false). Inak sa nikdy nepošle.
#     E-mail zákazníkovi z iDokladu nejde pri testovacej platbe nikdy.
# Po vystavení aplikácia faktúru v iDoklade označí ako uhradenú (dátum platby
# zo Stripe) a požiada iDoklad, aby ju poslal e-mailom zákazníkovi (na e-mail
# hlavného používateľa účtu, uložený na kontakte v iDoklade). Prvé ostré
# odoslanie musí vlastník sledovať (README, Production deploy checklist).
# IDOKLAD_DRAFT_MODE sa už nepoužíva (nikdy nevytváral koncepty) — odstráň ho.
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=
# IDOKLAD_ISSUE_MODE=prepare
# IDOKLAD_ALLOW_TEST_EVENTS=false

# Verejná URL aplikácie — používa Stripe pre návrat z Checkoutu a Customer Portal.
APP_BASE_URL=http://localhost:5173

# Email(y) účtov, ktoré majú prístup do Settings → Admin (trial_days, ceny).
# Comma-separated. Bez tohto je admin sekcia nedostupná každému.
# Na tieto adresy chodia aj upozornenia fakturácie (platba bez faktúry, faktúra
# na kontrolu, účet na ručné riešenie, dve predplatné, odmietnutá denná kontrola).
# Pozor: každá adresa tu je zároveň administrátor celej aplikácie.
ADMIN_EMAIL=

# SMTP transakčné maily — prázdny SMTP_HOST v deve zaloguje obsah do php logov.
# V produkcii doplň hodnoty od tvojho SMTP providera (Mailgun / SendGrid /
# vlastný server). SMTP_ENCRYPTION akceptuje: tls | ssl | none.
#
# Lokálne odchytenie mailov: docker-compose.yml má službu `mailpit`
# (SMTP na mailpit:1025, web UI na http://localhost:8025). Použi:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_ENCRYPTION=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=POapp
